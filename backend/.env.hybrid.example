# Hybrid (local vLLM + local Ollama) deployment env overrides.
#
# Copy the bits you care about into .env.local — start_local.sh / run_hybrid.sh
# both source .env and .env.local automatically.
#
# Rule of thumb: this file only lists the keys that differ from the stock
# start_local.sh defaults. Everything else (ADMIN_KEY, ENCRYPTION_SECRET,
# FIRESTORE_EMULATOR_HOST, …) has a safe default baked into start_local.sh.

# --- LLM: route Omi's OpenAI/Anthropic/OpenRouter calls through LiteLLM ---
OPENAI_API_KEY=sk-litellm-local-master
OPENAI_BASE_URL=http://localhost:4000/v1
ANTHROPIC_API_KEY=sk-litellm-local-master
ANTHROPIC_BASE_URL=http://localhost:4000
OPENROUTER_API_KEY=sk-litellm-local-master

# --- LiteLLM proxy upstreams (used by run_hybrid.sh when it spawns LiteLLM) ---
VLLM_MODEL_ID=gemma-4-26b-a4b-it-fp8
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=dummy
EMBED_MODEL_ID=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434
LITELLM_MASTER_KEY=sk-litellm-local-master
LITELLM_PORT=4000

# --- STT ---
# Phase 1: leave Deepgram on (fill DEEPGRAM_API_KEY).
# Phase 2: flip to whisper_streaming / whisper_batch_local once the local
# Whisper server is wired in utils/stt/providers/whisper.py.
DEEPGRAM_API_KEY=
STT_DEFAULT_REALTIME_PROVIDER=deepgram_streaming
STT_DEFAULT_FINALIZE_PROVIDER=deepgram_batch

# --- Firestore ---
# Two options, pick one:
#   (a) Use the local emulator baked into start_local.sh — leave both unset
#       and FIRESTORE_EMULATOR_HOST=localhost:8080 applies automatically.
#   (b) Use a real Firebase project (needed for iPhone app auth round-trip):
#       export FIRESTORE_EMULATOR_HOST= (empty string disables emulator)
#       GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#       FIREBASE_PROJECT_ID=<your-project-id>
FIRESTORE_EMULATOR_HOST=
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
# FIREBASE_PROJECT_ID=

# --- Redis ---
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=

# --- Tailscale-reachable bind ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
